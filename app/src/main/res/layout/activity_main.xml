<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/MAD_Pr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MAD_Alarm_Practical"
                android:textSize="25sp"
                android:layout_margin="15dp"
                app:layout_constraintTop_toTopOf="parent">

            </TextView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="20dp"
                app:layout_constraintTop_toBottomOf="@id/MAD_Pr">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/clock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:src="@drawable/alarm_photo"
                        app:layout_constraintTop_toTopOf="parent">

                    </ImageView>

                    <TextView
                        android:id="@+id/txt1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:text="Create Alarm Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/clock">

                    </TextView>

                    <TextView
                        android:id="@+id/txt2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:textSize="15sp"
                        android:text="By pressing buttons, Alarm can be created and cancelled."
                        app:layout_constraintTop_toBottomOf="@id/txt1">

                    </TextView>

                    <TextView
                        android:id="@+id/txt3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:textSize="15sp"
                        android:text="Check Current time by looking below real digital clock."
                        app:layout_constraintTop_toBottomOf="@id/txt2">

                    </TextView>

                    <TextClock
                        android:id="@+id/Time1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:format12Hour="hh:mm:ss a MMM, dd yyyy"
                        android:layout_margin="10dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/txt3">

                    </TextClock>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/CreateAlarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#43A047"
                        android:layout_marginTop="10dp"
                        android:drawableTint="@color/white"
                        android:drawableLeft="@drawable/outline_alarm_add_24"
                        android:text="Create Alarm"
                        app:layout_constraintStart_toStartOf="@id/txt3"
                        app:layout_constraintTop_toBottomOf="@id/Time1">

                    </com.google.android.material.button.MaterialButton>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="20dp"
                app:layout_constraintTop_toBottomOf="@id/card1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/clock1"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/alarm_photo2"
                        app:layout_constraintTop_toTopOf="parent">

                    </ImageView>

                    <TextView
                        android:id="@+id/txt4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:text="Set Alarm Time:"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/clock1">

                    </TextView>

                    <TextClock
                        android:id="@+id/Time2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:format12Hour="hh:mm:ss a"
                        android:layout_margin="5dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/txt4">

                    </TextClock>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/CancelAlarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#43A047"
                        android:drawableTint="@color/white"
                        android:drawableLeft="@drawable/baseline_alarm_off_24"
                        android:text="Cancel Alarm"
                        app:layout_constraintStart_toStartOf="@id/txt4"
                        app:layout_constraintTop_toBottomOf="@id/Time2">

                    </com.google.android.material.button.MaterialButton>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>